---
import ActionPanel from "../components/ActionPanel.astro";
import PoolTable from "../components/PoolTable.astro";
import PositionPanel from "../components/PositionPanel.astro";
import TopBar from "../components/TopBar.astro";
import Layout from "../layouts/Layout.astro";
import { STAKING_ADDRESS, TOKEN_SYMBOL } from "../lib/contracts";
import { chain } from "../lib/chain";
---

<Layout
  title="SushiFlush Staking"
  description={`Stake ${TOKEN_SYMBOL} on ${chain.name} and track your rewards.`}
>
  <TopBar />

  <main class="mx-auto w-full max-w-3xl px-5 pb-16">
    <PositionPanel />
    <ActionPanel />
    <PoolTable />

    <footer class="text-[12px] text-faint">
      <a
        class="font-mono underline underline-offset-4 hover:text-muted"
        href={`${chain.blockExplorers.default.url}/address/${STAKING_ADDRESS}`}
        target="_blank"
        rel="noreferrer">{STAKING_ADDRESS}</a
      >
    </footer>
  </main>
</Layout>

<script>
  // Astro bundles this through Vite, so it can import from src/lib directly.
  // The page is static HTML until this runs; there is no hydration step.
  import { start } from "../lib/dapp";

  start();
</script>
