<section id="activity-panel" class="border-t border-line py-7 sm:py-9">
  <h2 class="label">Your activity</h2>

  <!-- Rows are built by the client module; this is the empty/loading slot. -->
  <p id="activity-note" class="mt-3 text-[13px] text-muted"></p>
  <ul id="activity-list" class="mt-3 divide-y divide-line border-y border-line" hidden></ul>

  <button
    id="activity-more"
    type="button"
    class="mt-3 rounded-lg border border-line px-3.5 py-1.5 text-[13px] font-medium transition-colors hover:bg-sunken disabled:opacity-35"
    hidden
  >
    Load earlier
  </button>
</section>
