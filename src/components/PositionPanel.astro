---
import { TOKEN_SYMBOL } from "../lib/contracts";

/** The three states a holder's tokens can be in, read left to right. */
const figures = [
  { id: "pos-wallet", label: "In wallet", note: false },
  { id: "pos-staked", label: "Staked", note: true },
  { id: "pos-earned", label: "Claimable", note: false },
];
---

<section id="position-panel" class="border-b border-line py-9">
  <div class="grid gap-8 sm:grid-cols-3 sm:gap-0">
    {
      figures.map((figure, index) => (
        <div class={index === 0 ? "sm:pr-8" : "sm:border-l sm:border-line sm:px-8"}>
          <h2 class="label">{figure.label}</h2>
          <p class="mt-2.5 flex items-baseline gap-1.5">
            <span id={figure.id} class="figure text-figure font-medium">
              —
            </span>
            <span class="text-[13px] text-muted">{TOKEN_SYMBOL}</span>
          </p>
          {figure.note && <p id={`${figure.id}-note`} class="mt-2 h-4 text-[13px] text-muted" />}
        </div>
      ))
    }
  </div>

  <!-- Below the figures rather than inside the last column: the actions need
       more width than a third of the row, and the numbers read cleaner alone. -->
  <div class="mt-7 flex flex-wrap gap-2">
    <button
      id="reward-claim"
      type="button"
      class="rounded-lg border border-line px-3.5 py-1.5 text-[13px] font-medium transition-colors hover:bg-sunken disabled:opacity-35 disabled:hover:bg-transparent"
    >
      Claim rewards
    </button>
    <button
      id="reward-exit"
      type="button"
      title="Withdraw the full stake and claim rewards in one transaction"
      class="rounded-lg px-3.5 py-1.5 text-[13px] font-medium text-muted transition-colors hover:bg-sunken hover:text-ink disabled:opacity-35 disabled:hover:bg-transparent disabled:hover:text-muted"
    >
      Withdraw all &amp; claim
    </button>
  </div>
</section>
