---
import { TOKEN_SYMBOL } from "../lib/contracts";
---

<header class="flex flex-wrap items-center justify-between gap-3">
  <div>
    <h1 class="text-2xl font-semibold">SushiFlush Staking</h1>
    <p class="text-sm text-neutral-500">
      Sepolia testnet · stake {TOKEN_SYMBOL}, earn {TOKEN_SYMBOL}
    </p>
  </div>

  <!-- Both branches ship in the HTML; the client module toggles [hidden]. -->
  <div id="wallet-connect" class="flex flex-wrap gap-2">
    <span id="wallet-empty" class="text-sm text-neutral-500" hidden>
      No browser wallet detected.
    </span>
  </div>

  <div id="wallet-account" class="flex items-center gap-2" hidden>
    <code
      id="wallet-address"
      class="rounded bg-neutral-100 px-2 py-1 font-mono text-xs dark:bg-neutral-800"></code>
    <button
      id="wallet-disconnect"
      type="button"
      class="rounded-md border border-neutral-300 px-3 py-1.5 text-sm hover:bg-neutral-100 dark:border-neutral-700 dark:hover:bg-neutral-800"
    >
      Disconnect
    </button>
  </div>
</header>

<p id="wallet-error" class="text-sm text-red-600 dark:text-red-400" hidden></p>

<div
  id="network-warning"
  class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm dark:border-amber-800 dark:bg-amber-950"
  hidden
>
  <span>Wrong network. This app only works on Sepolia.</span>
  <button
    id="network-switch"
    type="button"
    class="rounded-md bg-amber-600 px-3 py-1.5 font-medium text-white hover:bg-amber-500"
  >
    Switch to Sepolia
  </button>
</div>
