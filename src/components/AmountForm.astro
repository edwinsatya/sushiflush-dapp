---
interface Props {
  /** Prefix for every id in this form: `${id}-amount`, `${id}-max`, … */
  id: string;
  title: string;
  action: string;
  /** Describes what the max button fills in, e.g. "Wallet balance". */
  balanceLabel: string;
}

const { id, title, action, balanceLabel } = Astro.props;
---

<form
  id={id}
  class="flex flex-col gap-3 rounded-xl border border-neutral-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-900"
>
  <div class="flex items-baseline justify-between gap-2">
    <h2 class="font-medium">{title}</h2>
    <button
      id={`${id}-max`}
      type="button"
      class="text-xs text-neutral-500 underline underline-offset-2 hover:text-neutral-900 dark:hover:text-neutral-100"
    >
      {balanceLabel}: <span id={`${id}-available`}>—</span>
    </button>
  </div>

  <input
    id={`${id}-amount`}
    name="amount"
    type="text"
    inputmode="decimal"
    autocomplete="off"
    placeholder="0.0"
    class="w-full rounded-md border border-neutral-300 bg-transparent px-3 py-2 font-mono tabular-nums outline-none focus:border-neutral-900 dark:border-neutral-700 dark:focus:border-neutral-100"
  />

  <button
    id={`${id}-submit`}
    type="submit"
    class="rounded-md bg-neutral-900 px-4 py-2 text-sm font-medium text-white disabled:opacity-40 hover:bg-neutral-700 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-200"
  >
    {action}
  </button>
</form>
