---
interface Props {
  /** Element id the client module writes the value into. */
  id: string;
  label: string;
  /** Static hint, when the card has nothing dynamic to say. */
  hint?: string;
}

const { id, label, hint } = Astro.props;
---

<div
  class="rounded-xl border border-neutral-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-900"
>
  <div class="text-xs font-medium uppercase tracking-wide text-neutral-500">{label}</div>
  <div id={id} class="mt-1 font-mono text-xl tabular-nums">—</div>
  <div id={`${id}-hint`} class="mt-1 text-xs text-neutral-500">{hint}</div>
</div>
