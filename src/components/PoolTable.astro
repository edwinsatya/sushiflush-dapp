---
import StatRow from "./StatRow.astro";
---

<section class="py-9">
  <h2 class="label">Pool</h2>
  <dl class="mt-3 divide-y divide-line border-y border-line">
    <StatRow id="pool-apr" label="Reward rate (annualised)" />
    <StatRow id="pool-total" label="Total staked" />
    <StatRow id="pool-emission" label="Emission" />
    <StatRow id="pool-remaining" label="Remaining this period" />
    <StatRow id="pool-ends" label="Reward period ends" />
  </dl>
</section>
