---
import { TOKEN_SYMBOL } from "../lib/contracts";
---

<section
  class="flex flex-wrap items-center justify-between gap-4 rounded-xl border border-neutral-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-900"
>
  <div>
    <div class="text-xs font-medium uppercase tracking-wide text-neutral-500">
      Claimable rewards
    </div>
    <div class="mt-1 font-mono text-2xl tabular-nums">
      <span id="reward-earned">—</span>
      <span class="ml-1 text-base text-neutral-500">{TOKEN_SYMBOL}</span>
    </div>
    <div class="mt-1 text-xs text-neutral-500">Refreshed every 5s</div>
  </div>

  <div class="flex gap-2">
    <button
      id="reward-claim"
      type="button"
      class="rounded-md bg-neutral-900 px-4 py-2 text-sm font-medium text-white disabled:opacity-40 hover:bg-neutral-700 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-200"
    >
      Claim
    </button>
    <button
      id="reward-exit"
      type="button"
      title="Withdraw the full stake and claim rewards in one transaction"
      class="rounded-md border border-neutral-300 px-4 py-2 text-sm font-medium disabled:opacity-40 hover:bg-neutral-100 dark:border-neutral-700 dark:hover:bg-neutral-800"
    >
      Exit
    </button>
  </div>
</section>
